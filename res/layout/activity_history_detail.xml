<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailMainContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen"
    android:fitsSystemWindows="true">

    <!-- Fixed Material 3 Top Bar -->
    <LinearLayout
        android:id="@+id/headerHistoryDetail"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/bg_surface"
        android:elevation="1dp">

        <ImageView
            android:id="@+id/btnDetailBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/btn_cancel" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_detail_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvDetailDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/color_primary"
                android:singleLine="true" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnDetailSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_search"
            android:tint="@color/text_primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/history_search_hint" />

        <ImageView
            android:id="@+id/btnDetailDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_delete"
            android:tint="@color/color_error"
            android:background="@drawable/m3_btn_delete_circle"
            android:padding="9dp"
            android:contentDescription="@string/btn_clear" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/detailRootLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="always">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

        <!-- Search Match Navigation Banner (Shown when searching) -->
        <LinearLayout
            android:id="@+id/layoutSearchMatchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/search_match_bar_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/color_on_secondary_container"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/etDetailSearchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/history_search_hint"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/color_on_secondary_container"
                    android:textSize="13sp"
                    android:background="@null"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />

                <TextView
                    android:id="@+id/tvSearchMatchCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_secondary_container"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="6dp" />

                <ImageView
                    android:id="@+id/btnSearchPrevMatch"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_arrow_up"
                    android:tint="@color/color_on_secondary_container"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:contentDescription="Previous Match" />

                <ImageView
                    android:id="@+id/btnSearchNextMatch"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_arrow_down"
                    android:tint="@color/color_on_secondary_container"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:contentDescription="Next Match" />

                <ImageView
                    android:id="@+id/btnSearchDismiss"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/color_on_secondary_container"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="7dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/btn_cancel" />
            </LinearLayout>
        </LinearLayout>

        <!-- Transcription Result Card -->
        <LinearLayout
            android:id="@+id/cardDetailResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_header"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etDetailResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="6"
                android:gravity="top|start"
                android:textAlignment="viewStart"
                android:background="@null"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.3"
                android:textIsSelectable="true"
                android:editable="false"
                android:focusable="false"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDetailWordCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary" />

                <Button
                    android:id="@+id/btnDetailClear"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="@string/btn_clear"
                    android:textSize="12sp"
                    android:textColor="@color/color_error"
                    android:background="@drawable/button_secondary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- AI Summary Card -->
        <LinearLayout
            android:id="@+id/layoutDetailSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/summary_card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvDetailSummaryHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/summary_header"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_tertiary_container" />

                <Button
                    android:id="@+id/btnDetailCopySummary"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="@string/btn_copy_summary"
                    android:textSize="11sp"
                    android:textColor="@color/color_on_tertiary_container"
                    android:background="@drawable/button_secondary"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailSummaryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:textSize="14sp"
                android:textColor="@color/color_on_tertiary_container"
                android:lineSpacingMultiplier="1.25"
                android:textIsSelectable="true" />
        </LinearLayout>

        <!-- Primary Action Buttons (Copy, Share, Export) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDetailCopy"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/btn_copy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="none"
                android:textColor="@color/color_on_primary"
                android:background="@drawable/button_primary"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnDetailShare"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/btn_share"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="none"
                android:textColor="@color/color_on_secondary_container"
                android:background="@drawable/button_tonal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnDetailExport"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/btn_export"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="none"
                android:textColor="@color/color_primary"
                android:background="@drawable/button_secondary"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
</LinearLayout>
