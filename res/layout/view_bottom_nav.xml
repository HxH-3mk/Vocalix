<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavBar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:background="@color/bg_surface"
    android:elevation="8dp"
    android:baselineAligned="false">

    <!-- Nav Item 1: Home (الرئيسية) -->
    <LinearLayout
        android:id="@+id/navItemHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">

        <ImageView
            android:id="@+id/navIconHome"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_nav_home"
            android:tint="@color/color_primary"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/navLabelHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_home"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary" />
    </LinearLayout>

    <!-- Nav Item 2: History (السجل) -->
    <LinearLayout
        android:id="@+id/navItemHistory"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">

        <ImageView
            android:id="@+id/navIconHistory"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_history"
            android:tint="@color/text_secondary"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/navLabelHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_history"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Nav Item 3: Settings (الإعدادات) -->
    <LinearLayout
        android:id="@+id/navItemSettings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">

        <ImageView
            android:id="@+id/navIconSettings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_secondary"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/navLabelSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

</LinearLayout>
